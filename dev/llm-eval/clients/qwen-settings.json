  "mcpServers": {
    "glafira-kubernetes": {
      "command": "/Applications/Glafira for Kubernetes.app/Contents/MacOS/glafira-kubernetes",
      "args": [
        "mcp"
      ],
      "timeout": 120000,
      "trust": true,
      "alwaysLoadTools": true
    }
  },
  "$version": 4
